#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(set=0,binding=0,std140)uniform Params{
    mat4 reprojection;
    mat4 inverseProjection;
    mat4 bodyReprojection;
    vec4 jitter; // xy applied pixel jitter, z viewport y sign, w internal view
    vec4 planes; // x reverse Z, y rigid-body transform valid, z conservative history rejection
    vec4 ownSphere;
}p;
#ifdef DEPTH_MSAA
layout(set=0,binding=1)uniform sampler2DMSArray nativeDepth;
#else
layout(set=0,binding=1)uniform sampler2DArray nativeDepth;
#endif
layout(set=0,binding=2,r32f)writeonly uniform image2D depthOut;
layout(set=0,binding=3,rg16f)writeonly uniform image2D motionOut;
layout(set=0,binding=4,r8)writeonly uniform image2D reactiveOut;
void main(){
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy),size=imageSize(depthOut);
    if(any(greaterThanEqual(xy,size)))return;
    vec2 uv=(vec2(xy)+0.5)/vec2(size);
    float depth;
#ifdef DEPTH_MSAA
    // Resolve nearest covered geometry, not an average across unrelated surfaces.
    // Keep the same depth convention as the camera and the FSR context.
    bool validSample=false;
    depth=p.planes.x>0.5?0.0:1.0;
    for(int sampleIndex=0;sampleIndex<textureSamples(nativeDepth);++sampleIndex){
        float z=texelFetch(nativeDepth,ivec3(xy,0),sampleIndex).r;
        if(isnan(z)||isinf(z)||z<0||z>1)continue;
        validSample=true;
        depth=p.planes.x>0.5?max(depth,z):min(depth,z);
    }
    if(!validSample)depth=uintBitsToFloat(0x7fc00000u);
#else
    depth=texelFetch(nativeDepth,ivec3(xy,0),0).r;
#endif
    bool invalidDepth=isnan(depth)||isinf(depth)||depth<0||depth>1;
    if(invalidDepth)depth=p.planes.x>0.5?0.0:1.0;
    vec2 unjittered=uv-p.jitter.xy/vec2(size);
    vec4 clip=vec4(unjittered*2.0-1.0,depth,1.0);
    clip.y*=p.jitter.z;
    bool sky=p.planes.x>0.5?depth<1e-7:depth>0.9999999;
    bool cockpit=false, invalidEye=false;
    // Exterior scenery needs one reprojection only. Reconstruct eye position
    // only inside the cockpit; compare homogeneous squared distances without
    // a perspective divide or square root.
    if(!sky&&p.jitter.w>0.5){
        vec4 eye=p.inverseProjection*clip;
        invalidEye=any(isnan(eye))||any(isinf(eye));
        cockpit=!invalidEye&&dot(eye.xyz,eye.xyz)<16.0*eye.w*eye.w;
    }
    bool body=cockpit&&p.planes.y>0.5;
    vec4 previous=(body?p.bodyReprojection:p.reprojection)*clip;
    bool invalidProjection=previous.w<=1e-7||any(isnan(previous))||any(isinf(previous))||invalidEye;
    vec2 motion=vec2(0);
    if(!invalidProjection){
        vec2 oldUv=previous.xy/previous.w;
        oldUv.y*=p.jitter.z;oldUv=oldUv*0.5+0.5;
        motion=(oldUv-unjittered)*vec2(size);
    }
    float reactive=invalidDepth?1.0:body?.05:cockpit?1.0:0.0;
    // A radius around the aircraft also contains runway/terrain in external
    // views. It cannot identify aircraft pixels, so never discard world history
    // using that sphere. Keep scenery/sky reconstruction continuous while panning.
    // Cockpit displays animate independently of the rigid cabin. Clouds also
    // lack reliable per-pixel motion in this capture. Prefer fresh samples in
    // these regions; this is a broad heuristic, not cockpit-screen extraction.
    if(p.planes.z>0.5){
        if(cockpit)reactive=max(reactive,0.2);
        if(sky)reactive=max(reactive,0.15);
    }
    if(any(isnan(motion))||any(isinf(motion))||invalidProjection||invalidDepth||
       any(greaterThan(abs(motion),vec2(size)*2.0))){motion=vec2(0);reactive=1;}
    imageStore(depthOut,xy,vec4(depth));imageStore(motionOut,xy,vec4(clamp(motion,vec2(-32700),vec2(32700)),0,0));
    imageStore(reactiveOut,xy,vec4(reactive));
}
