#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(set=0,binding=0)uniform sampler inputSampler;
layout(set=0,binding=1)uniform texture2DArray u_input_texture;
layout(set=0,binding=2,rgba16f)writeonly uniform image2DArray i_output_texture;
layout(set=0,binding=3)uniform u_fsr_data{vec4 dimensions;}params;
void main(){ivec2 xy=ivec2(gl_GlobalInvocationID.xy),size=imageSize(i_output_texture).xy;if(any(greaterThanEqual(xy,size)))return;
 vec2 uv=(vec2(xy)+0.5)/vec2(size);vec4 color=texture(sampler2DArray(u_input_texture,inputSampler),vec3(uv,0));
 imageStore(i_output_texture,ivec3(xy,0),color*params.dimensions.w);}
